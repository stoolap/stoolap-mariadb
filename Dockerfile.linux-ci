# Reproduces the GitHub Actions Linux CI environment for local iteration.
# Built once, then re-run quickly via `docker run` against the mounted repo.
#
# Build:  docker build --platform linux/amd64 -f Dockerfile.linux-ci -t stoolap-linux-ci .
# Run:    docker run --rm --platform linux/amd64 \
#             -v $PWD:/work -v /tmp/stoolap-ci-artifact:/staging:ro \
#             -w /work stoolap-linux-ci /work/scripts/linux-ci-entrypoint.sh
#
# /staging must contain libstoolap.so + stoolap.h (pull from `gh run download`
# or build via cargo).

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends -qq \
        curl ca-certificates apt-utils gnupg \
    && curl -LsS https://r.mariadb.com/downloads/mariadb_repo_setup \
        | bash -s -- --mariadb-server-version=11.4 --skip-maxscale --skip-tools \
    && apt-get update -qq \
    && apt-get install -y --no-install-recommends -qq \
        mariadb-server libmariadbd-dev \
        cmake g++ make \
        python3 python3-pip \
        clang-format-18 \
    && pip install --break-system-packages --quiet mysql-connector-python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# MariaDB ships an apparmor profile that interferes with our spawned
# mariadbd inside containers; the test runner uses --no-defaults so it
# bypasses the system config, but apparmor still applies if installed.
# We don't install apparmor here; document it so anyone extending the
# image knows to skip it.
